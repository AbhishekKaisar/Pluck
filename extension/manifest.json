{
  "manifest_version": 3,
  "name": "Pluck",
  "version": "1.0.0",
  "key": "",
  "description": "Hands browser downloads to the Pluck app on your Mac for faster multi-connection downloading.",
  "minimum_chrome_version": "110",
  "homepage_url": "https://github.com/AbhishekKaisar/Pluck",
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pluck",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
